{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prm-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "prm-dev-noauth",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "DISABLE_AUTH=true",
        "NODE_ENV=development",
        "tsx",
        "server/index.ts"
      ],
      "port": 5000,
      "autoPort": true
    }
  ]
}