# ============================================================
# People Manager CRM - Environment Configuration
# ============================================================
# Copy this file to .env and configure for your environment
#
# QUICK START OPTIONS:
# -----------------------------------------------------------
# Option 1: Local PostgreSQL (using docker-compose.dev.yml)
#   DATABASE_URL=postgresql://prm:prm_dev_password@localhost:5432/people_crm
#
# Option 2: Local PostgreSQL (manual install)
#   DATABASE_URL=postgresql://your_user:your_password@localhost:5432/people_crm
#
# Option 3: External PostgreSQL Server
#   DATABASE_URL=postgresql://user:password@your-server.com:5432/database_name
# ============================================================

# DATABASE CONNECTION (Required)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://prm:prm_dev_password@localhost:5432/people_crm

# SESSION SECRET (Required)
# For development, the default is fine. For production, generate with:
#   Linux/macOS: openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
SESSION_SECRET=dev-session-secret-change-me-in-production

# NODE ENVIRONMENT
# development = hot reload, verbose errors
# production = optimized, minimal errors
NODE_ENV=development

# S3-COMPATIBLE OBJECT STORAGE (Optional for development)
# Required for profile image uploads
# Leave blank to run without image upload support
# Supports: AWS S3, MinIO, DigitalOcean Spaces, Cloudflare R2, etc.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# PRM-S3 (dedicated image server; defaults, overridable in Image Storage settings)
# Internal endpoint: used by this server and other tools on the LAN
PRM_S3_ENDPOINT=http://localhost:9000
# Public endpoint: browsers load presigned image URLs from here.
# Leave blank to proxy images through this server instead.
PRM_S3_PUBLIC_ENDPOINT=
PRM_S3_BUCKET=images
PRM_S3_REGION=us-east-1
PRM_S3_ACCESS_KEY=
PRM_S3_SECRET_KEY=

# ============================================================
# DEVELOPMENT TIPS
# ============================================================
# 1. S3 storage is optional - the app works without it (no image uploads)
# 2. For local development with Docker, use docker-compose.dev.yml
# 3. For native development, install PostgreSQL locally or use a cloud instance
# ============================================================

# WHISPER SPEECH-TO-TEXT (Optional)
# Used by dictation and the Describe Me game. Defaults for the bundled
# speaches container (docker-compose.whisper.yml / start-dev). Can be
# overridden per-user in Settings -> Intelligence.
WHISPER_API_URL=http://localhost:8000
WHISPER_MODEL=Systran/faster-distil-whisper-small.en
